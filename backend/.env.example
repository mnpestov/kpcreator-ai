PORT = 3000

DB_NAME = kpcreatorai
DB_USER = postgres
DB_PASSWORD = postgres
DB_HOST = localhost
DB_PORT = 5432

# Секрет для подписи JWT. Сгенерировать, например: openssl rand -hex 32
JWT_SECRET = change-me

# Токен бота из @BotFather (/newbot). Нужен для проверки подписи initData
# в Telegram Mini App (см. backend/controllers/authController.js).
# Без него вход через Telegram Mini App работать не будет.
TELEGRAM_BOT_TOKEN =

# Адрес и ключ Telegram Gateway (см. backend/services/pdfDeliveryService.js).
# Без них отправка PDF в Telegram из Mini App будет падать с ошибкой 500.
TELEGRAM_GATEWAY_BASE_URL =
TELEGRAM_GATEWAY_API_KEY =
